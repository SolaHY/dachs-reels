# ローカル実行用。GitHub Actions では workflow の env / secrets から渡る。
GITHUB_REPO=SolaHY/dachs-reels
GITHUB_TOKEN=github_pat_...        # Contents:RW / Actions:RW

# --- Instagram ---
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- 運用パラメータ ---
LIVE_RATIO=1.0        # 投稿に占める実写の目標比率。1.0 で AI 生成を止める
QUEUE_TARGET=7        # 投稿待ちの目標在庫（日数ぶん）
MIX_HISTORY=10        # 比率判定で見る直近の投稿数
MIN_RUNWAY=2          # 在庫がこれを下回ったら比率を無視して AI で埋める
PET_NAMES=こむぎとあずき

# --- 企画生成 ---
PROMPT_PROVIDER=gemini   # gemini | template
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# --- AI 動画生成（LIVE_RATIO=1.0 なら不要）---
PIXVERSE_API_KEY=
PIXVERSE_MODEL=v5
PIXVERSE_QUALITY=720p
PIXVERSE_DURATION=5

# --- トークン自動延長用（Secrets:RW の PAT）---
GH_ADMIN_TOKEN=
